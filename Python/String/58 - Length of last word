"""
Description:
Given a string containing words separated by spaces, return
the length of the last word in the string.

Input:
"Hello World"

Output:
5

Time: O(n)
Space: O(1)
"""

#solution
def lastWordLength(s):
    words=s.split()
    word=words[-1]
    return len(word)


s="He is an honest man"
print(lastWordLength(s))