"""
Description:
Given an array of integers and a target value, find the indices
of two distinct elements whose sum is equal to the target.

Input:
[2, 7, 11, 15], target = 9

Output:
[0, 1]

Time: O(n)
Space: O(n)
"""

#solution
def two_sum(nums,target):
    hashmap={}
    for i,n in enumerate(nums):
        diff = target - n
        if diff in hashmap:
            return [hashmap[diff],i]
        hashmap[n] = i
    return

target = 9
nums=[2,7,11,15]
print(two_sum(nums,target))